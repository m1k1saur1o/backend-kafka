# Copia este archivo como .env (ignorado por git) y completa los valores.
#   cp .env.example .env
# Genera un secreto robusto con:  openssl rand -base64 48

# ---------- auth-service ----------
AUTH_USERNAME=
# Texto plano (se cifra con BCrypt al arrancar) o ya codificado: {bcrypt}$2a$10$...
# Si usas {bcrypt} en .env escapa cada $ como $$ para Docker Compose.
AUTH_PASSWORD=
AUTH_ROLES=USER,ADMIN
JWT_EXPIRATION_SECONDS=3600

# Cliente de servicio de ms-bff (grant client_credentials en POST /auth/token). Recibe el rol
# AUDIT_PUBLISHER para publicar eventos de auditoria en producer-service.
# Debe coincidir con AUTH_CLIENT_ID / AUTH_CLIENT_SECRET del .env de sumativa2.
# Genera el secreto con:  openssl rand -hex 24
AUTH_CLIENT_ID=ms-bff
AUTH_CLIENT_SECRET=

# ---------- JWT (compartido por auth, producer, consumer y ms-bff) ----------
JWT_SECRET=
JWT_ISSUER=sumativa3-auth-service
# Audiencia validada por producer-service y consumer-service
JWT_AUDIENCE=notificaciones-api
# Audiencia validada por ms-bff (auth-service la agrega al claim aud de cada token)
BFF_JWT_AUDIENCE=bff-api

# ---------- Eureka (discovery-service) ----------
# HTTP Basic del registro. Solo [A-Za-z0-9._~-] (van dentro de la URL de Eureka);
# la clave debe tener al menos 16 caracteres. Genera una con:  openssl rand -hex 20
# Deben coincidir con EUREKA_USERNAME / EUREKA_PASSWORD del .env de sumativa2.
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=

# ---------- Kafka ----------
# Host anunciado en el listener EXTERNAL (clientes fuera de Docker). En EC2: DNS/IP de la instancia.
KAFKA_EXTERNAL_HOST=localhost
# Dentro de Docker Compose los servicios usan los nombres DNS internos por defecto:
# KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_TOPIC=Notificaciones
KAFKA_CONSUMER_GROUP_ID=notificaciones-consumer
# Topico de auditoria de llamadas a ms-bff (separado de Notificaciones) y su consumer group
BFF_EVENTS_TOPIC=bff-call-events
BFF_EVENTS_CONSUMER_GROUP_ID=bff-auditoria-consumer
# Retencion del topico de auditoria (7 dias)
BFF_EVENTS_RETENTION_MS=604800000
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_LISTENER_CONCURRENCY=3

# Seguridad cliente-broker (solo si los brokers tienen SASL habilitado)
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="<usuario>" password="<clave>";

# ---------- Resiliencia (Resilience4j) ----------
# auth-service: intentos de login permitidos por ventana (exceso -> 429)
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_PERIOD_SECONDS=60
# producer-service: intentos totales de publicacion y Circuit Breaker hacia Kafka
KAFKA_PUBLISH_RETRY_ATTEMPTS=2
CB_FAILURE_RATE_THRESHOLD=50
CB_WAIT_OPEN_SECONDS=30
# consumer-service: solicitudes HTTP por segundo (exceso -> 429)
CONSUMER_API_RATE_LIMIT=20

# ---------- Puertos publicados en el host ----------
AUTH_PORT=8080
PRODUCER_PORT=8081
# producer-service es interno (ms-bff lo usa via Eureka): solo se publica en 127.0.0.1
PRODUCER_BIND=127.0.0.1
CONSUMER_PORT=8082
# Dashboard de Eureka (con HTTP Basic): solo 127.0.0.1 por defecto
EUREKA_PORT=8761
EUREKA_BIND=127.0.0.1
# Red Docker compartida con sumativa2 (ms-bff, ms-backend)
SHARED_NETWORK=sumativa-net
# Kafka UI no tiene autenticacion: por defecto solo escucha en 127.0.0.1
KAFKA_UI_BIND=127.0.0.1
